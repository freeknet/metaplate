{
  "name": "metaplate",
  "version": "0.8.2",
  "description": "Typed social-image contracts for TypeScript: rendering, metadata, routes, and verification.",
  "keywords": [
    "open-graph",
    "og-image",
    "nextjs",
    "social-image",
    "satori"
  ],
  "license": "MIT",
  "author": "Lawrence Norton",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "docs",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js",
      "default": "./dist/next.js"
    },
    "./render": {
      "types": "./dist/render.d.ts",
      "import": "./dist/render.js",
      "default": "./dist/render.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js",
      "default": "./dist/node.js"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "default": "./dist/edge.js"
    },
    "./fonts": {
      "types": "./dist/fonts.d.ts",
      "import": "./dist/fonts.js",
      "default": "./dist/fonts.js"
    },
    "./font-data": {
      "types": "./dist/font-data.d.ts",
      "import": "./dist/font-data.js",
      "default": "./dist/font-data.js"
    },
    "./emoji": {
      "types": "./dist/emoji.d.ts",
      "import": "./dist/emoji.js",
      "default": "./dist/emoji.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "import": "./dist/png.js",
      "default": "./dist/png.js"
    },
    "./image": {
      "types": "./dist/image.d.ts",
      "import": "./dist/image.js",
      "default": "./dist/image.js"
    },
    "./assets": {
      "types": "./dist/assets.d.ts",
      "import": "./dist/assets.js",
      "default": "./dist/assets.js"
    },
    "./cli": {
      "types": "./dist/run-cli.d.ts",
      "import": "./dist/run-cli.js",
      "default": "./dist/run-cli.js"
    }
  },
  "bin": {
    "metaplate": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "check": "npm run lint && npm run check:duplicates && npm run check:workflows && npm run check:dependencies && npm run check:deployment && npm run check:release-notes && npm run typecheck && npm run typecheck:examples && npm test && npm run build && npm pack --dry-run",
    "check:duplicates": "jscpd src scripts tests examples --min-lines 8 --min-tokens 60 --reporters console --ignore \"**/fixtures/**\" --threshold 0",
    "dependencies:report": "node scripts/supply-chain/dependency-inventory.mjs > dependency-inventory.json",
    "check:dependencies": "node scripts/supply-chain/dependency-inventory.mjs --summary && node scripts/supply-chain/verify-dependency-inventory.mjs && node scripts/supply-chain/verify-socket-dispositions.mjs",
    "check:deployment": "node scripts/release/verify-deployment-evidence.mjs",
    "check:workflows": "node scripts/supply-chain/workflow-policy.mjs",
    "release:evidence": "node scripts/release/release-checks.mjs && node scripts/release/release-evidence-report.mjs && node scripts/release/verify-evidence-bundle.mjs",
    "socket:report": "node scripts/supply-chain/socket-report.mjs",
    "check:package": "node scripts/package/verify-package.mjs",
    "check:release-notes": "node scripts/release/validate-release-notes.mjs",
    "check:evidence-bundle": "node scripts/release/verify-evidence-bundle.mjs",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "typecheck:examples": "tsc -p tsconfig.examples.json --noEmit"
  },
  "peerDependencies": {
    "@resvg/resvg-js": ">=2.6.2 <3",
    "@resvg/resvg-wasm": ">=2.6.2 <3",
    "next": ">=16.3.2 <17",
    "react": ">=18.2.0 <20",
    "satori": ">=0.38.2 <1"
  },
  "peerDependenciesMeta": {
    "@resvg/resvg-wasm": {
      "optional": true
    },
    "next": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/node": "11.1.11",
    "@eslint/js": "^10.0.0",
    "@fontsource/inter": "^5.2.8",
    "@react-router/dev": "8.5.1",
    "@react-router/node": "8.5.1",
    "@react-router/serve": "8.5.1",
    "@resvg/resvg-js": "^2.6.2",
    "@resvg/resvg-wasm": "2.6.2",
    "@sveltejs/adapter-node": "6.0.1",
    "@sveltejs/kit": "3.1.1",
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.3.0",
    "astro": "7.4.7",
    "eslint": "^10.0.0",
    "express": "5.3.0",
    "jscpd": "5.4.2",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-router": "8.5.1",
    "satori": "0.63.2",
    "svelte": "5.57.3",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.41.0",
    "vite": "8.3.6",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "esbuild": "^0.28.2",
    "minimatch": "^11.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true,
    "registry": "https://registry.npmjs.org"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/freeknet/metaplate.git"
  },
  "bugs": {
    "url": "https://github.com/freeknet/metaplate/issues"
  },
  "homepage": "https://github.com/freeknet/metaplate#readme"
}
